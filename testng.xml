<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test Suite" parallel="classes" thread-count="6">
    <listeners>
        <listener class-name="com.example.listeners.RetryListener"/>
    </listeners>

    <test name="API Tests">
        <classes>
            <class name="com.example.tests.api.PostsApiTest"/>
            <class name="com.example.tests.api.CommentsApiTest"/>
            <class name="com.example.tests.api.UsersApiTest"/>
            <class name="com.example.tests.api.TodosApiTest"/>
            <class name="com.example.tests.api.NestedRoutesApiTest"/>
            <class name="com.example.tests.api.QueryFeaturesApiTest"/>
        </classes>
    </test>

    <test name="UI Tests">
        <classes>
            <class name="com.example.tests.ui.buttons.ButtonsClickTest"/>
            <class name="com.example.tests.ui.buttons.ButtonsVisibilityTest"/>
            <class name="com.example.tests.ui.webtables.WebTablesDefaultDataTest"/>
            <class name="com.example.tests.ui.webtables.WebTablesSearchTest"/>
            <class name="com.example.tests.ui.webtables.WebTablesCrudTest"/>
            <class name="com.example.tests.ui.webtables.WebTablesPaginationTest"/>
            <class name="com.example.tests.ui.form.PracticeFormSubmissionTest"/>
            <class name="com.example.tests.ui.form.PracticeFormGenderTest"/>
            <class name="com.example.tests.ui.form.PracticeFormHobbiesTest"/>
            <class name="com.example.tests.ui.form.PracticeFormDatePickerTest"/>
            <class name="com.example.tests.ui.form.PracticeFormLocationTest"/>
            <class name="com.example.tests.ui.accessibility.AccessibilityTest"/>
        </classes>
    </test>
</suite>

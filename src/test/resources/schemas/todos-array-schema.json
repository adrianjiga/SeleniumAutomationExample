{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TodoList",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["userId", "id", "title", "completed"],
    "properties": {
      "userId": { "type": "integer" },
      "id": { "type": "integer" },
      "title": { "type": "string" },
      "completed": { "type": "boolean" }
    }
  }
}
